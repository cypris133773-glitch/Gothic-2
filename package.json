{
  "name": "grimward",
  "version": "0.0.1",
  "private": true,
  "description": "GRIMWARD \u2014 an open-world action RPG in the 2003 German RPG tradition, running in a browser tab.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.js",
    "dev": "node tools/serve.js",
    "test": "node tools/test.js",
    "shot": "node tools/shot.mjs",
    "play": "node tools/play.mjs",
    "perf": "node tools/perf.mjs",
    "perf:baseline": "node tools/perf.mjs --baseline",
    "check": "npm test && npm run shot && npm run play"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
